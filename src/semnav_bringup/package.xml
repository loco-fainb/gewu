<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semnav_bringup</name>
  <version>0.1.0</version>
  <description>
    语义导航项目（三室一厅一卫一厨）的场景与启动入口：程序化生成的住宅世界、
    语义真值清单、Gazebo 启动文件、SLAM/Nav2 配置，以及可复现验证脚本。
    仿真底座复用 oomwoo_one 机器人模型（Apache-2.0）。
  </description>

  <maintainer email="rufus-dargon@example.com">rufus-dargon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>oomwoo_one</exec_depend>
  <exec_depend>oomwoo_gazebo</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
