# ── colcon 构建产物（可完全重新生成，不入库）──
build/
install/
log/

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*.egg-info/

# ── 运行时临时产物 ──
# TF 帧关系图（tf2_tools view_frames 的调试转储，非机器人轨迹图）
frames_*.gv
frames_*.pdf

# SLAM 会话文件：地图入库，但这两个是可重跑生成的中间态
maps/*.data
maps/*.posegraph

# rosbag：体积大且可由 e2e_phase1.sh 重录
bags/
*.bag
*.bag.active

# ── 编辑器 / 系统 ──
.vscode/
.idea/
*.swp
*~
.DS_Store

# ── 外部素材 / 数据集（体积大，非本仓库产物，不入库）──
data/
# 仅根目录的早期副本（15M，未被 CMake 引用）；
# src/semnav_models/official_models/ 是运行时必需，必须入库
/official_models/

# ── 手工备份目录（内容已被当前配置取代）──
.backup-*/

# ── Gazebo GUI 视角调试残留（截图用，非运行必需）──
gui_*.config

# ── 散落在仓库根的中间产物（真源在 src/semnav_bringup/config/）──
/apartment_empty_reference.pgm
/apartment_empty_reference.png
/bedrooms_furnished_reference.yaml
