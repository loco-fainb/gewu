# 模型资源：禁止任何换行转换与文本归一化
# 原因：.dae/.obj 可能含二进制块，.png 是二进制；被 CRLF->LF 改写后
#       Gazebo 会加载失败或贴图错位。git add 时曾对 model.sdf/.obj/.dae
#       报 "CRLF will be replaced by LF"，故在此显式关闭。
src/semnav_models/official_models/** -text -diff
src/semnav_models/official_models/**/*.png binary
src/semnav_models/official_models/**/*.jpg binary
src/semnav_models/official_models/**/*.dae -text
src/semnav_models/official_models/**/*.obj -text
src/semnav_models/official_models/**/*.mtl -text

# 地图栅格（PGM 可能是二进制 P5，绝不能做换行转换）
maps/*.pgm binary
maps/*.png binary

# PDF 调试产物
*.pdf binary
